# ==============================================================================
# Configuración para scripts/sync_clientes_externos.sh
# Copia este archivo como:
#   cp scripts/.env.sync.example scripts/.env.sync.local   (para pruebas locales)
#   cp scripts/.env.sync.example scripts/.env.sync.prod    (para producción)
# NUNCA subas archivos .env.sync* con credenciales reales a Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# BASE DE DATOS ORIGEN (Plataforma externa de clientes - SOLO LECTURA)
# Modo: "docker" (ejecuta mysql/mysqldump dentro de un contenedor) o "mysql" (TCP directo)
# ------------------------------------------------------------------------------
SRC_MODE="docker"
SRC_DOCKER_CONTAINER="mrp-db"
SRC_HOST="127.0.0.1"
SRC_PORT="3306"
SRC_USER="root"
SRC_PASS="CAMBIAR_PASSWORD_ORIGEN"
SRC_DB="test_origen_clientes"
# Opcional para producción remota con TLS (ej. "--ssl-mode=REQUIRED")
SRC_EXTRA_OPTS=""

# ------------------------------------------------------------------------------
# BASE DE DATOS DESTINO (MRP)
# ------------------------------------------------------------------------------
DST_MODE="docker"
DST_DOCKER_CONTAINER="mrp-db"
DST_HOST="127.0.0.1"
DST_PORT="3306"
DST_USER="root"
DST_PASS="CAMBIAR_PASSWORD_DESTINO"
DST_DB="db_mrp_sync_test"
DST_EXTRA_OPTS=""

# ------------------------------------------------------------------------------
# REGLAS DE NEGOCIO Y DEFAULTS DEL ETL
# ------------------------------------------------------------------------------
# Usuario existente en db_mrp.usuarios.idusuario para auditoría
SYNC_USUARIO_ID="1"
# Valores por defecto cuando el origen trae NULL en columnas NOT NULL del MRP
SYNC_DEFAULT_TIPO_CLIENTE_ID="1"
SYNC_DEFAULT_REGIMEN_ID="1"
SYNC_DEFAULT_REGIMEN_SAT="601"
SYNC_DEFAULT_USO_CFDI="G03"
# 1 = incluir cli_clientes_contactos, 0 = omitir contactos
SYNC_INCLUDE_CONTACTOS="1"
# 1 = sincronizar también registros con estado=0/1 del origen, 0 = solo activos (estado=2)
SYNC_ONLY_ACTIVE="0"

# Carpeta donde se guardan respaldos .sql.gz antes de ejecutar --apply
BACKUP_DIR="backups/sync_clientes"
